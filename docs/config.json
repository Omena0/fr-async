  "build": {
    "workers": 6,
    "minify_html": true,
    "optimize_html": true,
    "zstd_level": 22,
    "search_index_filename": "search_index.zst",
    "git_meta_filename": "git_meta.zst"
  },
  "versioning": {
    "commit_message_pattern": "^\\s*([0-9]+[A-Za-z])\\s*[-:\u2014\u2013]\\s*(.+)",
    "live_label": "Live"
  },
  "source_files": {
    "search_dirs": [
      "parent",
      "src_parent",
      "docs"
    ],
    "patterns": [
      "docs/src/*.md",
      "docs/*.js",
      "docs/*.css"
    ],
    "ignore_dirs": []
  },
  "features": {
    "backlinks": true,
    "related": true,
    "auto_link": true,
    "versioning": true,
    "search": true,
    "code_references": true,
    "link_preview": true,
    "code_highlighting": true,
    "blockquotes": true,
    "ext_tags": true,
    "inline_copy": true
  }
}